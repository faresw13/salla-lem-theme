
<section class="featured-products">
  <h2>منتجات مختارة</h2>
  <div class="product-grid">
    {% for product in collections.frontpage.products %}
      <div class="product-card">
        <a href="{{ product.url }}">
          <img src="{{ product.featured_image | img_url: '500x' }}" alt="{{ product.title }}">
          <h3>{{ product.title }}</h3>
        </a>
      </div>
    {% endfor %}
  </div>
</section>
